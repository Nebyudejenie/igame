{
  "title": "Zemen Game",
  "uid": "jo-bingo",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Concurrent connections",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum(gateway_connections)", "legendFormat": "connections", "refId": "A" }
      ]
    },
    {
      "id": 2,
      "title": "Rooms active",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum(engine_rooms_active)", "legendFormat": "rooms", "refId": "A" }
      ]
    },
    {
      "id": 3,
      "title": "Payout queue depth",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 50 }
            ]
          }
        }
      },
      "targets": [
        { "expr": "sum(payout_queue_depth)", "legendFormat": "depth", "refId": "A" }
      ]
    },
    {
      "id": 4,
      "title": "House revenue (live, ETB)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum(house_revenue_total)", "legendFormat": "ETB", "refId": "A" }
      ]
    },
    {
      "id": 5,
      "title": "Bingo calls/sec",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum(rate(engine_calls_total[1m]))", "legendFormat": "calls/sec", "refId": "A" }
      ]
    },
    {
      "id": 6,
      "title": "Ledger transactions/sec, by kind",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(ledger_transactions_total[1m])) by (kind)",
          "legendFormat": "{{kind}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Command-to-ack latency (p50/p95/p99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(gateway_command_ack_seconds_bucket[5m])) by (le, action))",
          "legendFormat": "p50 {{action}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(gateway_command_ack_seconds_bucket[5m])) by (le, action))",
          "legendFormat": "p95 {{action}}",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(gateway_command_ack_seconds_bucket[5m])) by (le, action))",
          "legendFormat": "p99 {{action}}",
          "refId": "C"
        }
      ]
    },
    {
      "id": 8,
      "title": "Claim validation time (p50/p95/p99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(engine_claim_validation_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(engine_claim_validation_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(engine_claim_validation_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ]
    },
    {
      "id": 9,
      "title": "Deposit success rate (15m window)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 22 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 } },
      "targets": [
        {
          "expr": "sum(rate(deposit_outcomes_total{outcome=\"credited\"}[15m])) / sum(rate(deposit_outcomes_total[15m]))",
          "legendFormat": "success rate",
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "title": "Rounds voided (refunded) per hour",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 22 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "increase(engine_rounds_voided_total[1h])",
          "legendFormat": "voided/hour",
          "refId": "A"
        }
      ]
    },
    {
      "id": 11,
      "title": "Telegram updates/sec (received vs deduplicated)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 30 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum(rate(telegram_updates_received_total[1m]))", "legendFormat": "received/sec", "refId": "A" },
        { "expr": "sum(rate(telegram_updates_deduplicated_total[1m]))", "legendFormat": "deduplicated/sec", "refId": "B" }
      ]
    },
    {
      "id": 12,
      "title": "Telegram webhook pending updates",
      "type": "stat",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 30 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 50 },
              { "color": "red", "value": 200 }
            ]
          }
        }
      },
      "targets": [
        { "expr": "sum(telegram_webhook_pending_updates)", "legendFormat": "pending", "refId": "A" }
      ]
    },
    {
      "id": 13,
      "title": "Telegram command latency (p50/p95/p99), by handler",
      "description": "Engineering targets (spec section 9): FAST commands p50<300ms/p95<800ms/p99<1500ms; NORMAL commands p95<1500ms. This panel is the source of truth for whether a real deployment meets them -- see docs/TELEGRAM_PERFORMANCE.md.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 38 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(telegram_command_latency_seconds_bucket[5m])) by (le, handler))",
          "legendFormat": "p50 {{handler}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(telegram_command_latency_seconds_bucket[5m])) by (le, handler))",
          "legendFormat": "p95 {{handler}}",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(telegram_command_latency_seconds_bucket[5m])) by (le, handler))",
          "legendFormat": "p99 {{handler}}",
          "refId": "C"
        }
      ]
    },
    {
      "id": 14,
      "title": "Telegram command error rate, by handler",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 38 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 } },
      "targets": [
        {
          "expr": "sum(rate(telegram_command_error_total[15m])) by (handler) / sum(rate(telegram_commands_total[15m])) by (handler)",
          "legendFormat": "{{handler}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 15,
      "title": "Telegram command latency breakdown: dispatch vs DB vs Redis vs Telegram API",
      "description": "Where the milliseconds actually go, decomposed. Dispatch delay is dedup + routing overhead only (see perf.py); DB/Redis are per-handler; Telegram API time is Notifier's own send_message() calls, shared across every command.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 46 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(telegram_dispatch_delay_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95 dispatch delay",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(telegram_db_duration_seconds_bucket[5m])) by (le, handler))",
          "legendFormat": "p95 db {{handler}}",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(telegram_redis_duration_seconds_bucket[5m])) by (le, handler))",
          "legendFormat": "p95 redis {{handler}}",
          "refId": "C"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(telegram_api_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95 telegram api",
          "refId": "D"
        }
      ]
    },
    {
      "id": 16,
      "title": "Commands blocked (admin-disabled), by handler",
      "description": "Telegram Command Center: a player still attempting a command an admin has disabled via the bot_commands registry. Sustained non-zero traffic here after a deliberate disable is expected; a spike with no known admin action is worth investigating.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 54 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(telegram_command_blocked_total[5m])) by (handler)",
          "legendFormat": "{{handler}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 17,
      "title": "Commands rate-limited, by handler and limit type",
      "description": "Phase 3: a player hitting their own configured cooldown_seconds or rate_limit_per_minute (services/bot/command_registry.py::command_gate_middleware). limit_type distinguishes a cooldown denial from a per-minute rate-limit denial. Sustained growth on one handler suggests its limit may be tighter than real usage warrants -- worth a look on the Telegram Commands admin screen, not necessarily a problem.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 62 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(telegram_command_rate_limited_total[5m])) by (handler, limit_type)",
          "legendFormat": "{{handler}} ({{limit_type}})",
          "refId": "A"
        }
      ]
    }
  ]
}

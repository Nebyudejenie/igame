# Copy to deploy/.env on the actual deployment server and fill in real
# values. Never commit deploy/.env. Read by deploy/docker-compose.prod.yml
# (env_file: .env, resolved relative to this same deploy/ directory) --
# distinct from the repo root's own .env.example, which is for local dev
# against deploy/docker-compose.yml instead.

# --- Postgres container itself ---
# The x-app-env anchor in docker-compose.prod.yml builds DATABASE_URL and
# DATABASE_URL_SYNC from these directly -- don't set DATABASE_URL here,
# it would be ignored (docker-compose's own environment: block always
# wins over anything from env_file for the same key).
POSTGRES_USER=jobingo
# No default in docker-compose.prod.yml on purpose -- an empty password
# default would be a real, silent security hole in a file whose whole
# purpose is production. Generate one: openssl rand -hex 32
POSTGRES_PASSWORD=
POSTGRES_DB=jobingo

# --- Telegram (Phase 1) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=
# The Mini App's own address -- the gateway's apex-hostname tunnel route
# (see deploy/cloudflared/config.yml.example), also the return_url Chapa
# sends a player's browser back to after paying, not just the bot's
# Play-button target.
# e.g. https://arada.click
MINIAPP_URL=

# --- Payment providers (Phase 5-6) ---
CHAPA_API_KEY=
SANTIMPAY_API_KEY=
ARIFPAY_API_KEY=
# The bot process's own externally-reachable base URL -- used only to
# build the Telegram webhook URL bot.py registers with Telegram. This
# deployment routes the webhook by path on the SAME apex hostname as
# MINIAPP_URL above (PathPrefix(/webhook) in deploy/cloudflared/config.yml
# .example), not a separate bot. subdomain -- distinct from
# PAYMENTS_PUBLIC_BASE_URL below regardless (see that var's own comment).
# e.g. https://arada.click
PUBLIC_BASE_URL=
# The payments service's own externally-reachable base URL -- Chapa's
# real server-to-server webhook (POST /webhooks/chapa) must land here, on
# THIS service, not wherever PUBLIC_BASE_URL points. Two different
# subdomains on two different tunnel routes (see deploy/cloudflared/
# config.yml.example) -- conflating them was a real bug this split fixed,
# see DECISIONS.md.
# e.g. https://payments.arada.click
PAYMENTS_PUBLIC_BASE_URL=
# The Payment Agent Portal's own externally-reachable base URL -- same
# backend container as PAYMENTS_PUBLIC_BASE_URL above, a second hostname
# (see docs/AGENT_DASHBOARD_GUIDE.md and deploy/cloudflared/config.yml
# .example).
# e.g. https://agent.arada.click
AGENT_PORTAL_BASE_URL=
MIN_DEPOSIT_ETB=10.00
DAILY_DEPOSIT_CAP_ETB=50000.00
MIN_WITHDRAW_ETB=200.00
AUTO_APPROVE_WITHDRAW_ETB=2000.00
KYC_REQUIRED_ABOVE_ETB=5000.00
WITHDRAW_CHARGEBACK_WINDOW_MINUTES=30
# spec 8.4: "Withdrawal velocity > 3/day -> Review."
MAX_WITHDRAWALS_PER_DAY=3

# --- Admin console (Phase 7) ---
# Comma-separated IPs. Empty means unrestricted -- fine for local dev,
# not for a real deployment; set this for real before going live.
ADMIN_IP_ALLOWLIST=

# --- Phone number encryption at rest (spec section 9.2) ---
# 64 hex chars (32 bytes). No safe default -- generate a real one, distinct
# from the repo's own dev key in .env.example (that one is public, it's
# committed):
# python -c "import secrets; print(secrets.token_hex(32))"
PHONE_ENCRYPTION_KEY=

# --- Observability ---
PUSHGATEWAY_URL=
OTEL_EXPORTER_ENDPOINT=

# --- App ---
ENVIRONMENT=production
LOG_LEVEL=INFO

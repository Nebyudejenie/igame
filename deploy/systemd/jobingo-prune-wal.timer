[Unit]
Description=Daily Zemen Game WAL/basebackup retention pruning

[Timer]
# Daily, after the backup/basebackup windows above -- pruning before a
# scheduled backup completes could theoretically race a very slow backup,
# so this runs later in the day rather than back-to-back with 02:00/03:00.
OnCalendar=*-*-* 04:00:00
Persistent=true
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
